{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://engine.quelchampagne.fr/schemas/tasting.schema.json",
  "title":"Dégustation structurée QuelChampagne",
  "type":"object",
  "required":["id","productId","taster","tastedAt","blind","axes"],
  "properties":{
    "id":{"type":"string"},"productId":{"type":"string"},"tastedAt":{"type":"string","format":"date"},"blind":{"type":"boolean"},
    "taster":{"type":"object","required":["id","level"],"properties":{"id":{"type":"string"},"level":{"enum":["consumer","enthusiast","sommelier","winemaker","critic"]}}},
    "axes":{"type":"object","minProperties":4,"additionalProperties":{"type":"number","minimum":1,"maximum":5}},
    "aromas":{"type":"array","items":{"type":"string"},"uniqueItems":true},"overall":{"type":"number","minimum":1,"maximum":5},"comment":{"type":"string","maxLength":1000}
  }
}
